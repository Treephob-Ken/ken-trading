# Hyperliquid agent wallet private key.
# Generate at: https://app.hyperliquid-testnet.xyz -> Settings -> API -> Generate API Wallet
# This key can place/cancel orders but CANNOT withdraw funds.
HL_AGENT_PRIVATE_KEY=0xYOUR_AGENT_PRIVATE_KEY_HERE

# Your main wallet address (the one that holds the test USDC and approved the agent).
HL_USER_ADDRESS=0xYOUR_MAIN_WALLET_ADDRESS_HERE

# 'testnet' or 'mainnet'. Leave as testnet until you trust the bot.
HL_NETWORK=testnet

# ─── Remote access (optional) ───────────────────────────────────────────────
# Leave everything below blank for a localhost-only setup. Fill it in only when
# exposing the bot beyond your machine (e.g. through a Cloudflare Tunnel).
# See bot/REMOTE_ACCESS.md for the full walkthrough.

# Extra browser origins allowed to call the API, comma-separated, exact match.
# This is the hosted dashboard's origin. localhost is always allowed.
# e.g. ALLOWED_ORIGINS=https://app.yourdomain.com
ALLOWED_ORIGINS=

# Shared-secret API token (SINGLE-TENANT ONLY). When set, every /api/* request must send
# `Authorization: Bearer <token>`. Use a long random string. Ignored when MULTI_USER=true.
# With Cloudflare Access in front you can leave this blank; set it for a plain tunnel.
BOT_API_TOKEN=

# ─── Trade safety caps (optional, recommended for remote access) ────────────
# Hard limits enforced server-side. 0 or blank disables the cap.

# Largest single-order notional in USD (size x price).
MAX_TRADE_NOTIONAL_USD=

# Comma-separated allow-list of tradeable assets. Blank = any asset.
# e.g. ALLOWED_ASSETS=ETH,BTC,SOL
ALLOWED_ASSETS=

# Most filled/attempted orders allowed per rolling 60 minutes.
MAX_TRADES_PER_HOUR=

# ─── Multi-user mode (Phase B) ───────────────────────────────────────────────
# Set MULTI_USER=true to enable per-user accounts, login, and isolated bots.
# Leave blank (or unset) to keep the current single-tenant behaviour.
MULTI_USER=

# Email of the first admin/owner. The first person who registers with this
# email address gets admin privileges (can see all users, kill bots).
# Also, the very first registered user ALWAYS gets admin regardless of email.
OWNER_EMAIL=

# Comma-separated email whitelist. When set, ONLY these emails can register.
# Leave blank to allow anyone to register.
# e.g. ALLOWED_EMAILS=ken2540@gmail.com,friend@gmail.com
ALLOWED_EMAILS=

# 64-hex-char secret used to encrypt each user's HL agent private key at rest.
# NEVER share or lose this — without it, stored keys are permanently unreadable.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
KEY_ENCRYPTION_SECRET=

# 32+ char secret used to sign JWT session tokens.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
